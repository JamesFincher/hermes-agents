# Host env for research-bot HDR. Copy to .env and fill values.
# Never commit .env. Official interpolation: ${env:VAR} in config.yaml / mcp.json.
# https://hermes-agent.nousresearch.com/docs/user-guide/configuration

# Retrieval
# SEARXNG_URL=
# FIRECRAWL_API_URL=

# MCP (Context7 library docs only — not the research spine)
# CONTEXT7_API_KEY=

# Optional browser CDP. Our host name; official knob is browser.cdp_url.
# HERMES_CDP_URL=

# Literature HTTP fallbacks (skill scripts + scholar_search)
# UNPAYWALL_EMAIL=
# CROSSREF_MAILTO=
# SEMANTIC_SCHOLAR_API_KEY=

# Memory (Honcho Cloud). Self-hosted uses honcho.json baseUrl instead.
# HONCHO_API_KEY=

# Model provider key. This profile does not pin model.default.
# OPENAI_API_KEY=
