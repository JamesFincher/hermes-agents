# counsel-bot — copy to the installed profile's .env. Never commit real values.

# Primary-law retrieval and citation verification (strongly recommended).
COURTLISTENER_TOKEN=

# Federal statutes and the Federal Register.
GOVINFO_API_KEY=

# Deploy-host only: the self-hosted retrieval pair. Not in env_requires.
SEARXNG_URL=http://localhost:8888
FIRECRAWL_API_URL=http://localhost:3002

# Optional: CDP/anti-detection browser endpoint for JS-only court portals.
HERMES_CDP_URL=
